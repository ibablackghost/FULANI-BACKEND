{
  "collectionName": "components_product_color_images",
  "info": {
    "displayName": "Photo par couleur",
    "description": "Photo du produit pour une couleur — upload OU URL",
    "icon": "picture"
  },
  "options": {},
  "attributes": {
    "colorName": {
      "type": "string",
      "required": true
    },
    "color": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::color.color"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Upload Strapi (prioritaire si rempli)"
    },
    "imageUrl": {
      "type": "string",
      "description": "URL externe si pas d’upload (ex. https://fulaniofficial.com/...)"
    },
    "imageAlt": {
      "type": "string"
    }
  }
}
