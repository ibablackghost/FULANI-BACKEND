{
  "kind": "collectionType",
  "collectionName": "variants",
  "info": {
    "singularName": "variant",
    "pluralName": "variants",
    "displayName": "Variant",
    "description": "Variantes vendables (Top, Ensemble, taille, couleur…)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "format": {
      "type": "string",
      "required": true
    },
    "label": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "colorName": {
      "type": "string"
    },
    "colorHex": {
      "type": "string"
    },
    "color": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::color.color"
    },
    "sizeRef": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::size.size"
    },
    "price": {
      "type": "integer",
      "min": 0
    },
    "compareAtPrice": {
      "type": "integer",
      "min": 0
    },
    "stock": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "lowStockThreshold": {
      "type": "integer",
      "default": 5,
      "min": 0
    },
    "isDefault": {
      "type": "boolean",
      "default": false
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "position": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "imageUrl": {
      "type": "string"
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "required": true,
      "inversedBy": "variants"
    }
  }
}
